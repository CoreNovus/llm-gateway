# Copy to `.env` (next to docker-compose.yml) and populate.
# Anything in `.env` is loaded by docker compose automatically.

# REQUIRED — the bearer token clients send. Generate a strong one:
#   openssl rand -hex 32
BEARER_TOKEN=replace-me-with-openssl-rand-hex-32  # pragma: allowlist secret

# OPTIONAL — only needed for gated HuggingFace repos. Qwen2.5-7B-Instruct-AWQ
# is public, so leave empty unless you switch models.
HF_TOKEN=

# OPTIONAL — overrides for tuning. Leave defaulted unless you know why.
LOG_LEVEL=INFO
RATE_LIMIT_RPM=60
CIRCUIT_BREAKER_ENABLED=true

# OPTIONAL — directory the vLLM container mounts as the HF cache.
# Defaults to /models/hf-cache, the host's persistent data volume.
# Override if your data volume mounts somewhere else.
LLM_GATEWAY_HF_CACHE_DIR=/models/hf-cache
